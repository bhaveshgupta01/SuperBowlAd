# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key
# Optional model override; default is gemini-flash-lite-latest (free tier works
# on keys without billing; note gemini-2.0-flash's free tier was retired)
# GEMINI_MODEL=gemini-flash-lite-latest

# Sports Data APIs (optional for demo, required for real data)
FOOTBALL_DATA_API_KEY=your_football_data_api_key
RAPIDAPI_KEY=your_rapidapi_key

# Meta / WhatsApp Business (optional for production)
META_WA_VERIFY_TOKEN=your_wa_webhook_token
META_WA_ACCESS_TOKEN=your_wa_access_token

# Feature flags
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_USE_REAL_SPORTS_API=false
